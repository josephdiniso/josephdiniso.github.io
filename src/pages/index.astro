---
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/main.scss";
---

<SiteLayout>
    <div id="intro-header">
        <div id="intro-inner">
            <div id="intro-text">
                <div id="name-intro">
                    HEY THERE! I'M
                </div>
                <div id="full-name">
                    Joseph DiNiso
                </div>
                <div id="position-intro">
                    SOFTWARE ENGINEER
                </div>
                <div id="skills">
                    C# • Distributed Systems • Python • Azure • Plus Much More
                    <br>
                    Currently working in Redmond, WA 📍
                </div>
                <a id="resume-button" href="resume.html">VIEW MY RESUME</a>
            </div>
        </div>
        <img id="profilepic" alt="Joseph standing beside a waterfall"
            src="Images/portrait-720.jpg"
            srcset="Images/portrait-360.jpg 360w, Images/portrait-720.jpg 720w, Images/portrait-1080.jpg 1080w"
            sizes="(max-width: 431px) 58vw, (max-width: 806px) 250px, (max-width: 1161px) 31vw, 360px"
            width="720" height="960">
    </div>
    <div id="info-boxes">
        <div id="info-box-container">
            <div class="info-box" id="first-info-box">
                <div class="info-box-contents">
                    <h1>
                        My Projects
                    </h1>
                    <h3>
                        Check out some of the projects I've worked on:
                    </h3>
                    <ul>
                        <li><a href="https://github.com/josephdiniso/Drumz" target="_blank" rel="noopener noreferrer">Drumz</a> - Virtual reality drumset</li>
                        <li><a href="https://github.com/josephdiniso/YouQR" target="_blank" rel="noopener noreferrer">YouQR</a> - Custom QR code maker for YouTube
                            video links</li>
                        <li><a href="https://github.com/josephdiniso/PySnake" target="_blank" rel="noopener noreferrer">PySnake</a> - Snake made with PyGame
                            trained with Q learning</li>
                    </ul>
                    <h3>
                        View the rest of my projects <a href="projects.html">here</a>
                    </h3>
                </div>
            </div>
            <div class="info-box" id="second-info-box">
                <div class="info-box-contents">
                    <h1>
                        My Resume
                    </h1>
                    <h3>
                        Click <a href="resume.html">here</a> to see my resume
                    </h3>
                    <ul>
                        <li>
                            Software Engineer II in Microsoft Azure Core
                        </li>
                        <li>
                            M.S. in Computer Science from Georgia Tech (GPA 3.90)
                            <small class="degree-focus">Focus in Software Systems</small>
                        </li>
                        <li>
                            B.S. in Computer Engineering from Virginia Tech (GPA 3.85)
                            <small class="degree-focus">Focus in Machine Learning; secondary focus in Networking and Cybersecurity</small>
                        </li>
                        <li>
                            Proficient with C# and Python, experienced with Rust and C++
                        </li>
                    </ul>
                </div>
            </div>
            <div class="info-box" id="third-info-box">
                <div class="info-box-contents">
                    <h1>
                        Contact Me
                    </h1>
                    <ul>
                        <li>
                            <a href="https://www.linkedin.com/in/josephdiniso/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
                        </li>
                        <li>
                            <a href="https://github.com/josephdiniso" target="_blank" rel="noopener noreferrer">GitHub</a>
                        </li>
                        <li>
                            E-Mail: josephdiniso (at) gmail (dot) com
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

</SiteLayout>