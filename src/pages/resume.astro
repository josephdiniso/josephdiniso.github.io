---
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/resume.scss";
---

<SiteLayout title="Resume | Joseph DiNiso">
    <main class="resume-page">
        <div class="resume-heading">
            <h1>My Resume</h1>
            <div class="resume-actions">
                <a href="https://dinisogenericstorage.blob.core.windows.net/dinisowebsitepublicartifacts/DiNisoResume.pdf" target="_blank" rel="noopener noreferrer">Open PDF</a>
            </div>
        </div>
        <iframe class="resume-viewer"
            src="https://dinisogenericstorage.blob.core.windows.net/dinisowebsitepublicartifacts/DiNisoResume.pdf"
            title="Joseph DiNiso's resume PDF"></iframe>
        <p class="resume-help">If the preview doesn't load, use the Open PDF link above to access the PDF directly.</p>
    </main>
</SiteLayout>
